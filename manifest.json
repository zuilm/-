{
  "manifest_version": 3,
  "name": "AI 岗位匹配",
  "version": "1.3.5.18",
  "description": "根据简历和求职偏好分析 BOSS 直聘岗位，并可按匹配结果自动沟通。",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": ["js/ai-detail-reader.js", "js/ai-application.js"],
      "matches": ["https://www.zhipin.com/job_detail/*"],
      "run_at": "document_idle"
    },
    {
      "js": ["js/ai-application.js", "js/ai-matcher.js", "js/ai-launcher.js"],
      "matches": ["https://www.zhipin.com/web/*"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://www.zhipin.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "permissions": ["storage", "unlimitedStorage"],
  "options_page": "ai-options.html",
  "action": { "default_title": "设置 AI 岗位匹配" },
  "icons": {
    "16": "assets/icon_16.png",
    "32": "assets/icon_32.png",
    "48": "assets/icon_48.png",
    "128": "assets/icon_128.png"
  }
}
